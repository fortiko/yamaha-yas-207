[Unit]
Description=Bind /dev/rfcomm0 to Yamaha YAS-207 (BT SPP)
Documentation=https://github.com/fortiko/yamaha-yas-207
After=bluetooth.service bluetooth.target
Wants=bluetooth.service bluetooth.target

# Verified for the example installation:
#   MAC:     02:0A:0B:0C:0D:0E
#   channel: 1 (SPP)
# Override at install time by dropping a drop-in at
# /etc/systemd/system/yas207-rfcomm-bind.service.d/.
StartLimitBurst=10
StartLimitIntervalSec=60

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=YAS207_BT_MAC=02:0A:0B:0C:0D:0E
Environment=YAS207_RFCOMM_CHANNEL=1
Environment=YAS207_RFCOMM_DEV=/dev/rfcomm0
ExecStart=/usr/bin/rfcomm bind ${YAS207_RFCOMM_DEV} ${YAS207_BT_MAC} ${YAS207_RFCOMM_CHANNEL}
# The bind may transiently fail if the YAS has just powered on or the
# BlueZ discovery cache is stale; retry briefly.
Restart=on-failure
RestartSec=3

[Install]
WantedBy=bluetooth.target
