[Unit]
Description=Bind /dev/rfcomm0 to Yamaha YAS-207 (BT SPP)
Documentation=https://github.com/fortiko/yamaha-yas-207
After=bluetooth.service
Wants=bluetooth.service

# Tune the MAC and channel to your YAS-207. The default values are
# the verified configuration for our installation:
#   MAC:    02:0A:0B:0C:0D:0E
#   channel: 1 (SPP)
Environment=YAS207_BT_MAC=02:0A:0B:0C:0D:0E
Environment=YAS207_RFCOMM_CHANNEL=1
Environment=YAS207_RFCOMM_DEV=/dev/rfcomm0

[Service]
Type=oneshot
ExecStart=/usr/bin/rfcomm bind ${YAS207_RFCOMM_DEV} ${YAS207_BT_MAC} ${YAS207_RFCOMM_CHANNEL}
RemainAfterExit=yes
# If the bind fails (e.g., MAC not yet reachable), retry up to 5 times
# with a 3-second delay. The total wait is ~15 seconds.
Restart=on-failure
RestartSec=3
StartLimitBurst=5
StartLimitIntervalSec=30

[Install]
WantedBy=multi-user.target
