[Unit]
Description=Yamaha YAS-207 SPP controller (yas207)
Documentation=https://github.com/fortiko/yamaha-yas-207
# Start once Bluetooth is up AND the rfcomm bind has been performed.
# We do not Require the bind unit: the controller's serial worker retries
# on Errno::EIO and the unit-level Restart= recovers from transient drops.
After=bluetooth.target yas207-rfcomm-bind.service
Wants=bluetooth.target

[Service]
Type=simple
WorkingDirectory=/home/yas207/src/yamaha-yas-207
Environment=YAS207_CONFIG=/home/yas207/.config/yas207/controller.json
# Runtime dir is /run/user/<euid>/yas207 (resolved by the controller
# itself from Process.euid); no override required here.
ExecStart=/usr/bin/ruby control/control.rb
Restart=always
RestartSec=5
TimeoutStartSec=30

# Hardening: controller opens /dev/rfcomm0 and writes only under
# /run/user/<euid>/yas207/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
DeviceAllow=/dev/rfcomm0 rw
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
