{
  "_comment": [
    "Example profile: Sendspin over Example ALSA analogue output to YAS-207 ANALOG.",
    "Default location: ~/.config/yas207/controller.json",
    "Override via env: YAS207_CONFIG=/absolute/path/to/controller.json",
    "See docs/configuration.md for field semantics and docs/profiles.md for rationale."
  ],

  "controller": {
    "rfcomm_device":             "/dev/rfcomm0",
    "rfcomm_channel":            1,
    "bluetooth_address":         "02:0A:0B:0C:0D:0E",
    "http_bind":                 "127.0.0.1",
    "http_port":                 8000,
    "sync_timeout_seconds":      15,
    "status_refresh_seconds":    30,
    "manage_power":              false,
    "initial_intent":            {}
  },

  "session": {
    "name":                       "sendspin",
    "music_intent": {
      "input":      "analog",
      "clearvoice": false
    },
    "stop_debounce_seconds":     10,
    "disconnect_spp_after_session": false
  },

  "volume": {
    "min_nonzero_raw":           1,
    "max_raw":                   20,
    "zero_is_mute":              true,
    "default_percent":           50,
    "remember_when_inactive":    true
  },

  "player": {
    "type":        "sendspin",
    "name":        "Example Room",
    "interface":   "192.0.2.135",
    "audio_device": {
      "match":          "Example ALSA Device",
      "index_override": 0
    },
    "audio_format":   "flac:48000:16:2",
    "hardware_volume": false,
    "use_mpris":      false,
    "hooks": {
      "start":      "yas207-sendspin start",
      "stop":       "yas207-sendspin stop",
      "set_volume": "yas207-sendspin volume"
    }
  }
}
